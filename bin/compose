#!/usr/bin/env bash
# Compose wrapper: prefers `docker compose`; falls back to `podman compose` or `podman-compose`.
set -euo pipefail

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  exec docker compose "$@"
elif command -v podman >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
  exec podman compose "$@"
elif command -v podman-compose >/dev/null 2>&1; then
  exec podman-compose "$@"
else
  echo "No compose tool found. Install Docker Desktop, Podman 5+, or podman-compose." >&2
  exit 1
fi
